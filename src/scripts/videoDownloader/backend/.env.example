VD_BACKEND_APP_ENV=development
VD_BACKEND_HOST=127.0.0.1
VD_BACKEND_PORT=8787

# 使用逗号分隔，供 CORS 显式放行。
VD_BACKEND_CORS_ORIGINS=http://127.0.0.1,http://localhost
VD_BACKEND_CORS_ALLOW_ORIGIN_REGEX=https?://.*
VD_BACKEND_CORS_ALLOW_CREDENTIALS=true

# 下载目录（后端直接落盘到本机）。
VD_BACKEND_DOWNLOAD_ROOT=~/Downloads/videoDownloader
VD_BACKEND_MAX_CONCURRENT_TASKS=2
VD_BACKEND_TASK_RETENTION_SECONDS=43200

# yt-dlp
VD_BACKEND_YT_DLP_SOCKET_TIMEOUT=60
VD_BACKEND_YT_DLP_RETRIES=5

# 日志级别：DEBUG/INFO/WARN/ERROR
VD_BACKEND_LOG_LEVEL=INFO

# 如需 HTTPS/WSS，可设置证书路径并自行使用 uvicorn --ssl-certfile --ssl-keyfile
VD_BACKEND_SSL_CERTFILE=
VD_BACKEND_SSL_KEYFILE=
